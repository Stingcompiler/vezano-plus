{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://plus.vezano.app",
        "EXPO_PUBLIC_WEB_URL": "https://plus.vezano.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://plus.vezano.app",
        "EXPO_PUBLIC_WEB_URL": "https://plus.vezano.app"
      }
    }
  }
}
