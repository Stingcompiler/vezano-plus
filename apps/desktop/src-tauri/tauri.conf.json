{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vezano Plus",
  "mainBinaryName": "vezano-plus",
  "version": "0.1.6",
  "identifier": "app.vezano.plus",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "فيزانو بلص",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' blob: https://plus.vezano.app ipc: http://ipc.localhost; img-src 'self' data: blob: https://plus.vezano.app; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "Business",
    "shortDescription": "Vezano Plus — offline POS, inventory and ledger",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 660, "height": 432 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": true
      }
    },
    "longDescription": "Vezano Plus: point of sale, inventory and customer ledger that keep working offline."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Stingcompiler/vezano-plus/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
