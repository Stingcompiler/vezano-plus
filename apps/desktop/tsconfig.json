{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/lib/session-store": ["./src/platform/session-store.ts"],
      "@/lib/pwa": ["./src/platform/pwa.ts"],
      "@/lib/nav-extras": ["./src/platform/nav-extras.ts"],
      "@/lib/print/printers": ["./src/platform/printers.ts"],
      "@/*": ["../web/src/*"],
      "next/navigation": ["./src/shims/navigation.ts"],
      "next/link": ["./src/shims/link.tsx"]
    },
    "types": ["node", "web-bluetooth", "vite/client"],
    "resolveJsonModule": true,
    "strict": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
